# Configuration for aws-deploy.sh (uploads images/ and locales/ to S3 and invalidates CloudFront).
# Copy to .env and fill in CLOUDFRONT_DISTRIBUTION_ID. local-start.py does not read this file:
# it always serves this directory on http://localhost:4000 for local development.

# Target bucket, folder and region. These are the defaults used by aws-deploy.sh.
S3_BUCKET=rmu-static-assets-pro
S3_PREFIX=rmu-mfe-assets
AWS_REGION=eu-west-1

# Required: CloudFront distribution in front of the bucket.
CLOUDFRONT_DISTRIBUTION_ID=

# AWS credentials. Leave unset to use the default AWS CLI profile, or pick one:
# AWS_PROFILE=rmu
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
